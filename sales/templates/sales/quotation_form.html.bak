{% extends "base.html" %}
{% block title %}New Quotation{% endblock %}
{% block content %}
<div class="container">
  <h2>New Quotation</h2>
  <form method="post">
    {% csrf_token %}
    {{ form.as_p }}
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="{% url 'sales:quotation_list' %}" class="btn btn-secondary">Cancel</a>
  </form>
</div>
{% endblock %}
