{% extends "base.html" %}
{% block title %}Quotations{% endblock %}
{% block content %}
<div class="container-fluid">
  <div class="card shadow-sm rounded-2xl">
    <div class="card-header d-flex justify-content-between align-items-center">
      <h3 class="card-title">Quotations</h3>
	    <a class="btn btn-primary" href="{% url 'sales:quotation_create' %}">New Quotation</a>  <!-- 👈 -->

    </div>

    <div class="card-body p-0">
      <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
          <tr>
            <th style="width:120px;">Number</th>
            <th>Date</th>
            <th>Customer</th>
            <th>Origin</th>
            <th>Validity</th>
            <th style="width:100px;"></th>
          </tr>
        </thead>
        <tbody>
          {% for q in quotations %}
          <tr>
            <td class="fw-bold">{{ q.number }}</td>
            <td>{{ q.date }}</td>
            <td>{{ q.customer.name }}</td>
            <td>{{ q.origin }}</td>
            <td>{{ q.validity_date|default:"-" }}</td>
            <td><a class="btn btn-sm btn-primary" href="{% url 'sales:quotation_detail' q.pk %}">View</a></td>
			
          </tr>
          {% empty %}
          <tr><td colspan="6" class="text-center text-body-secondary py-4">No quotations</td></tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}
